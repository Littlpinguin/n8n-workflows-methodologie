      "id": "f74bfe88-d544-456e-b262-9dffa27d96c1",
      "name": "Telecharger prompt regroupement",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [928, 520],
      "executeOnce": true,
      "credentials": {
        "googleDriveOAuth2Api": {
