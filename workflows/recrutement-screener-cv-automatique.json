        "jsCode": "const response = $json.candidates[0].content.parts[0].text;\nconst candidate = JSON.parse(response);\nconst analysis = $('Construire prompt extraction').item.json.analysis;\n\nreturn [{ json: { candidate, analysis } }];"
      },
