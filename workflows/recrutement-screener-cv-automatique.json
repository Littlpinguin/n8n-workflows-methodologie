    {
      "parameters": {
        "jsCode": "const resume = $('Standardiser CV').item.json.resume;\nconst jobDescription = $json.text;\n\nconst systemPrompt = `# Overview\nTu es un recruteur technique expert specialise dans l'analyse de CV. On te donne une fiche de poste et un CV de candidat.\nAnalyse le CV par rapport a la fiche de poste et produis un rapport de screening detaille.\n\nEvalue l'alignement des competences techniques ET la comprehension du contexte metier.\nBase-toi uniquement sur le contenu reel du CV et de la fiche — pas d'hypotheses.\n\n# Output JSON\nRetourne un objet JSON avec exactement ces champs :\n- candidate_strengths: array de strings (liste des forces specifiques du candidat par rapport au poste)\n- candidate_weaknesses: array de strings (liste des faiblesses ou lacunes identifiees)\n- risk_factor: objet avec { score: \"Low\" ou \"Medium\" ou \"High\", explanation: string decrivant le pire scenario si ce candidat est recrute }\n- reward_factor: objet avec { score: \"Low\" ou \"Medium\" ou \"High\", explanation: string decrivant le meilleur scenario et si le candidat est un fit court-terme ou long-terme }\n- overall_fit_rating: integer de 0 a 10 (0 = aucun match, 10 = match parfait, pas de decimales)\n- justification_for_rating: string detaillee expliquant pourquoi ce score, avec references specifiques au CV et a la fiche de poste`;\n\nconst userPrompt = `## Fiche de poste\\n\\n${jobDescription}\\n\\n## CV du candidat\\n\\n${resume}`;\n\nconst requestBody = {\n  contents: [{ role: 'user', parts: [{ text: userPrompt }] }],\n  systemInstruction: { parts: [{ text: systemPrompt }] },\n  generationConfig: {\n    temperature: 0.3,\n    responseMimeType: 'application/json'\n  }\n};\n\nreturn [{ json: { requestBody, resume } }];"
      },
      "id": "build-prompt-analyse",
      "name": "Construire prompt analyse",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3744, -32]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.requestBody) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "gemini-analyse",
      "name": "Analyser CV via Gemini",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3968, -32],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "credentials": {
        "googlePalmApi": {
          "id": "N8N_RESOURCE_ID_06",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const response = $json.candidates[0].content.parts[0].text;\nconst analysis = JSON.parse(response);\nconst resume = $('Construire prompt analyse').item.json.resume;\n\nreturn [{ json: { analysis, resume } }];"
      },
      "id": "parse-analyse",
      "name": "Parser resultat analyse",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [4192, -32]
    },
    {
      "parameters": {
        "jsCode": "const resume = $json.resume;\nconst analysis = $json.analysis;\n\nconst systemPrompt = 'Extrais les informations de contact du candidat depuis son CV. Retourne un JSON avec exactement ces champs: first_name (string, prenom), last_name (string, nom de famille), email (string, adresse email). Si une info est introuvable, retourne une chaine vide.';\n\nconst requestBody = {\n  contents: [{ role: 'user', parts: [{ text: resume }] }],\n  systemInstruction: { parts: [{ text: systemPrompt }] },\n  generationConfig: {\n    temperature: 0.1,\n    responseMimeType: 'application/json'\n  }\n};\n\nreturn [{ json: { requestBody, analysis } }];"
      },
      "id": "build-prompt-extraction",
      "name": "Construire prompt extraction",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [4416, -32]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.requestBody) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "gemini-extraction",
      "name": "Extraire infos candidat",
