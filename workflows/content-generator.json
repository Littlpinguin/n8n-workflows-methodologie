        "url": "https://sheets.googleapis.com/v4/spreadsheets/GOOGLE_DOC_ID_04:batchUpdate",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ requests: [{ repeatCell: { range: { sheetId: 1269236147, startRowIndex: $('Parser contenu genere').item.json.rowNumber - 1, endRowIndex: Number($('Parser contenu genere').item.json.rowNumber), startColumnIndex: 0, endColumnIndex: 9 }, cell: { userEnteredFormat: { backgroundColor: { red: 0.851, green: 0.918, blue: 0.827 } } }, fields: 'userEnteredFormat.backgroundColor' } }] }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "http-format-row",
      "name": "Formater ligne verte",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3360, 208],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "N8N_RESOURCE_ID_03",
          "name": "Google Sheets account"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const parserItems = $('Parser contenu genere').all();\nconst success = parserItems.filter(i => !i.json.error);\nconst errors = parserItems.filter(i => i.json.error);\n\nconst details = success\n  .map(i => '- ' + i.json.plateforme + ' : ' + i.json.sujet_ref + '\\n  Titre : ' + i.json.titre)\n  .join('\\n');\n\nconst errorDetails = errors\n  .map(i => '- ERREUR (' + i.json.plateforme + ') : ' + i.json.message)\n  .join('\\n');\n\nreturn [{\n  json: {\n    count: success.length,\n    errors: errors.length,\n    details,\n    errorDetails,\n    summary: success.length + ' brouillon(s) genere(s)' + (errors.length > 0 ? ', ' + errors.length + ' erreur(s)' : '')\n  }\n}];"
      },
