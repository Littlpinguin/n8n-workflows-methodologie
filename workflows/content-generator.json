    {
      "parameters": {
        "jsCode": "const items = $input.all();\nreturn items.filter(item => {\n  const statut = (item.json.Statut || item.json.statut || '').trim().toUpperCase();\n  return statut === 'VALID\u00c9' || statut === 'VALIDE';\n});"
      },
      "id": "code-filter-1",
      "name": "Filtrer sujets VALIDE",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1344, 208]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst promptDocIds = {\n  'LinkedIn': 'GOOGLE_DOC_ID_19',\n  'Substack Article': 'GOOGLE_DOC_ID_20',\n  'Substack Notes': 'GOOGLE_DOC_ID_16'\n};\n\nreturn items.map(item => {\n  const plateforme = item.json.Plateforme || item.json.plateforme || 'LinkedIn';\n  return {\n    json: {\n      ...item.json,\n      promptDocId: promptDocIds[plateforme] || promptDocIds['LinkedIn']\n    }\n  };\n});"
      },
      "id": "code-mapper",
      "name": "Mapper prompt ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1568, 208]
    },
    {
      "parameters": {
        "operation": "download",
        "fileId": {
          "__rl": true,
          "value": "={{ $json.promptDocId }}",
          "mode": "id"
        },
        "options": {
          "googleFileConversion": {
            "conversion": {
              "docsToFormat": "text/plain"
            }
          }
        }
      },
      "id": "gdrive-dl-prompt",
      "name": "Telecharger prompt",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [1792, 208],
