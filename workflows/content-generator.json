      },
      "id": "extract-prompt",
      "name": "Extraire texte prompt",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [2016, 208]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst mapperItems = $('Mapper prompt ID').all();\nconst profil = $('Extraire texte profil').first().json.data || '';\nconst guide = $('Extraire texte guide').first().json.data || '';\n\nconst PB = '\\u007b\\u007bPROFIL_BUSINESS\\u007d\\u007d';\nconst GE = '\\u007b\\u007bGUIDE_EDITORIAL\\u007d\\u007d';\nconst SU = '\\u007b\\u007bSUJET\\u007d\\u007d';\nconst AN = '\\u007b\\u007bANGLE\\u007d\\u007d';\nconst SP = '\\u007b\\u007bSOURCES_PERPLEXITY\\u007d\\u007d';\nconst CS = '\\u007b\\u007bCONTENU_SOURCE\\u007d\\u007d';\n\nreturn items.map((item, index) => {\n  const promptText = item.json.data || '';\n  const orig = mapperItems[index]?.json || {};\n  \n  const sujet = orig.Sujet || orig.sujet || '';\n  const angle = orig.Angle || orig.angle || '';\n  const sources = orig.Sources || orig.sources || '';\n  const plateforme = orig.Plateforme || orig.plateforme || '';\n  const rowNumber = orig.row_number || '';\n\n  let prompt = promptText\n    .replace(PB, profil)\n    .replace(GE, guide)\n    .replace(SU, sujet)\n    .replace(AN, angle)\n    .replace(SP, sources)\n    .replace(CS, sources);\n\n  if (sources && !promptText.includes('SOURCES') && !promptText.includes('sources')) {\n    prompt += '\\n\\nSOURCES DE REFERENCE :\\n' + sources;\n  }\n\n  return {\n    json: { prompt, sujet, plateforme, angle, sources, rowNumber }\n  };\n});"
      },
      "id": "code-assemble",
      "name": "Assembler prompt final",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2240, 208]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3-pro-preview:generateContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ role: 'user', parts: [{ text: $json.prompt }] }], generationConfig: { responseMimeType: 'application/json', temperature: 0.7 } }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "gemini-generate",
      "name": "Gemini \u2014 Generer contenu",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2464, 208],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "credentials": {
        "googlePalmApi": {
          "id": "N8N_RESOURCE_ID_06",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst assemblerItems = $('Assembler prompt final').all();\n\nreturn items.map((item, index) => {\n  const response = item.json;\n  const text = response.candidates?.[0]?.content?.parts?.[0]?.text || '{}';\n  let contenu;\n  try {\n    contenu = JSON.parse(text);\n  } catch(e) {\n    const meta = assemblerItems[index]?.json || {};\n    return {\n      json: {\n        error: true,\n        message: 'Parsing JSON echoue',\n        raw: text.substring(0, 500),\n        sujet_ref: meta.sujet,\n        plateforme: meta.plateforme,\n        rowNumber: meta.rowNumber\n      }\n    };\n  }\n\n  const meta = assemblerItems[index]?.json || {};\n\n  return {\n    json: {\n      date: new Date().toISOString().split('T')[0],\n      sujet_ref: meta.sujet,\n      plateforme: meta.plateforme,\n      titre: contenu.titre || '',\n      hook: contenu.hook || contenu.accroche || '',\n      contenu: contenu.contenu || contenu.corps || '',\n      cta: contenu.cta || contenu.call_to_action || '',\n      hashtags: Array.isArray(contenu.hashtags) ? contenu.hashtags.join(', ') : (contenu.hashtags || ''),\n      statut: 'BROUILLON',\n      date_publication: '',\n      logs: 'WF2 Generator \\u2014 ' + new Date().toISOString(),\n      rowNumber: meta.rowNumber\n    }\n  };\n});"
      },
      "id": "code-parse",
      "name": "Parser contenu genere",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2688, 208]
